# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - NEXOU API
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo como `.env`
# 2. Reemplaza los valores con las credenciales de tu base de datos PostgreSQL (Neon.tech / Supabase)
# ==============================================================================

# URL JDBC de conexión a PostgreSQL
DB_URL=jdbc:postgresql://ep-example-12345.us-east-2.aws.neon.tech/nexou_db?sslmode=require

# Usuario de la base de datos
DB_USER=tu_usuario

# Contraseña de la base de datos
DB_PASSWORD=tu_contrasena

# Secreto para firmar los tokens JWT (mínimo 32 caracteres, inventa uno largo)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-o-mas-caracteres

# Administrador inicial (se crea al arrancar si no existe ningún admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Orígenes permitidos por CORS (frontend). Separados por coma. En local: http://localhost:5173
CORS_ORIGENES=http://localhost:5173
